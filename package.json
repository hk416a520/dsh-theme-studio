{
  "name": "dsh-theme-studio",
  "version": "0.1.0",
  "description": "DSH Theme Studio: recolor the workbench with RGB values, switch the light/dark scheme, and set a background image read from a local file.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "bundle",
    "theme",
    "appearance",
    "wallpaper",
    "color-picker"
  ],
  "license": "MIT",
  "author": "hk416a520",
  "homepage": "https://github.com/hk416a520/dsh-theme-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hk416a520/dsh-theme-studio.git"
  },
  "bugs": {
    "url": "https://github.com/hk416a520/dsh-theme-studio/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
